# PostgreSQL Connection Strings (Explicit per runtime — never defaults to production staycraft_pms)
DATABASE_URL=postgresql://pms_app:pms_local_dev_pw@127.0.0.1:5432/staycraft_pms_preview
PREVIEW_DATABASE_URL=postgresql://pms_app:pms_local_dev_pw@127.0.0.1:5432/staycraft_pms_preview
TEST_DATABASE_URL=postgresql://pms_app:pms_local_dev_pw@127.0.0.1:5432/staycraft_pms_test

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Session Configuration
SESSION_COOKIE_NAME=staycraft_session
SESSION_TTL_HOURS=24

# Public Guest QR & Account Recovery Base URL
# - Production (NODE_ENV=production): MUST be your deployed public https:// origin (no path/query; never a sandbox, LAN, or localhost URL):
#   PUBLIC_APP_URL=https://pms.yourhotel.com
# - Local Laptop / Same-Wi-Fi Demo (NODE_ENV=development): set your laptop's Wi-Fi LAN IP and port so a phone on the same Wi-Fi can scan the QR code:
#   PUBLIC_APP_URL=http://<your-laptop-lan-ip>:3000

